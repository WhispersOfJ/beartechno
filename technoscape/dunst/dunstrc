# Technoscape — dunst notifications

[global]
monitor = 0
follow = mouse
width = 350
height = 120
origin = top-right
offset = 12x40
scale = 0
notification_limit = 5
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 120
progress_bar_max_width = 240
indicate_hidden = yes
transparency = 12
separator_height = 2
padding = 10
horizontal_padding = 12
frame_width = 2
frame_color = "#00e5ff"
sort = yes
idle_threshold = 120
font = JetBrainsMono Nerd Font 10
line_height = 0
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes
icon_position = left
max_icon_size = 40
sticky_history = yes
history_length = 20
always_run_script = true
title = Dunst
class = Dunst

[urgency_low]
background = "#11151f"
foreground = "#a9b1d6"
highlight = "#565f89"
frame_color = "#565f89"
timeout = 6

[urgency_normal]
background = "#11151f"
foreground = "#a9b1d6"
highlight = "#00e5ff"
frame_color = "#00e5ff"
timeout = 8

[urgency_critical]
background = "#1f0a14"
foreground = "#ffffff"
highlight = "#ff2a6d"
frame_color = "#ff2a6d"
timeout = 0
